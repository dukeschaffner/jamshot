{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Next.js: debug server-side",
        "type": "node-terminal",
        "request": "launch",
        "command": "cd ui && npm run dev",
        "cwd": "${workspaceFolder}"
      },
      {
        "name": "Next.js: debug client-side",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder}/ui"
      },
      {
        "name": "Next.js: debug full stack",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/ui",
        "program": "${workspaceFolder}/node_modules/.bin/next",
        "runtimeArgs": ["--inspect"],
        "skipFiles": ["<node_internals>/**"],
        "serverReadyAction": {
          "action": "debugWithChrome",
          "killOnServerStop": true,
          "pattern": "- Local:.+(https?://.+)",
          "uriFormat": "%s",
          "webRoot": "${workspaceFolder}/ui"
        }
      },
      {
        "name": "Next.js: debug full stack (ephemeral)",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/ui",
        "program": "${workspaceFolder}/node_modules/.bin/next",
        "runtimeArgs": ["--inspect"],
        "env": {
          "JAMSHOT_ENV": "ephemeral"
        },
        "skipFiles": ["<node_internals>/**"],
        "serverReadyAction": {
          "action": "debugWithChrome",
          "killOnServerStop": true,
          "pattern": "- Local:.+(https?://.+)",
          "uriFormat": "%s",
          "webRoot": "${workspaceFolder}/ui"
        }
      }
    ]
  }