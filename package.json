{
  "name": "jamshot-monorepo",
  "version": "1.0.0",
  "description": "Jamshot monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "api/lambda",
    "ui",
    "cms",
    "issues-visualizer",
    "infrastructure/cdk",
    "functions/lambda/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspaces --if-present",
    "dev:backend": "./scripts/run-backend-services.sh",
    "dev:ephemeral": "JAMSHOT_ENV=ephemeral ./scripts/run-backend-services.sh",
    "ephemeral:setup": "./scripts/ephemeral-env/setup.sh",
    "ephemeral:teardown": "./scripts/ephemeral-env/teardown.sh"
  },
  "dependencies": {
    "@sterio/dev-env": "file:packages/dev-env",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
