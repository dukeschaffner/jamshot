{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "npm run build && electron-builder",
    "electron-dist": "npm run build && electron-builder --publish=never"
  },
  "build": {
    "appId": "com.sterio.app",
    "productName": "Sterio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "public/icon.png"
    },
    "win": {
      "icon": "public/icon.png"
    },
    "linux": {
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@payloadcms/live-preview-react": "^3.84.1",
    "@sterio/formatting-utils": "file:../packages/formatting-utils",
    "@sterio/subscription-utils": "file:../packages/subscription-utils",
    "@stripe/stripe-js": "^6.0.0",
    "@xyflow/react": "^12.10.1",
    "axios": "^1.8.1",
    "better-auth": "^1.4.10",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "howler": "^2.2.4",
    "js-cookie": "^3.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "next": "^16.2.6",
    "posthog-js": "^1.313.0",
    "prop-types": "^15.8.1",
    "radix-ui": "^1.6.1",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.6",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
