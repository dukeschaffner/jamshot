{
  "expo": {
    "name": "Jamshot",
    "slug": "jamshot-mobile",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jamshot.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jamshot.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "jamshot",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "./plugins/withJamShotAudio",
        {
          "tracktionEnginePath": "../tracktion_engine",
          "enableBackgroundAudio": true
        }
      ]
    ]
  }
}
