{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Lambda API (Local)",
        "skipFiles": ["<node_internals>/**"],
        "program": "${workspaceFolder}/lambda/dev-server.js",
        "runtimeArgs": ["--inspect"],
        "envFile": "${workspaceFolder}/lambda/.env",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/lambda"
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Run Lambda Handler Directly",
        "skipFiles": ["<node_internals>/**"],
        "program": "${workspaceFolder}/lambda/handler.js",
        "args": ["test"],
        "envFile": "${workspaceFolder}/lambda/.env",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/lambda"
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Lambda with Serverless Offline",
        "skipFiles": ["<node_internals>/**"],
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev"],
        "envFile": "${workspaceFolder}/lambda/.env",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/lambda",
        "outputCapture": "std"
      }
    ]
  }