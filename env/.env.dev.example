# Canonical local/dev env for the whole repo.
# Copy to env/.env.dev and fill in values:
#   cp env/.env.dev.example env/.env.dev
#
# Services load this file automatically. To override keys for a session:
#   1. Put only the changed keys in env/.env.local, or
#   2. JAMSHOT_ENV=ephemeral (loads env/.env.ephemeral on top of this file)
# Delete the overlay / unset JAMSHOT_ENV to return to these values.

# --- App ---
NODE_ENV=dev
PORT=5001
API_URL=http://localhost:5001/api
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:5001
BETTER_AUTH_SECRET=
JWT_SECRET=
PASS=

# --- Database ---
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=jamshot
DB_PORT=5432
DB_SSL=false
DB_CONNECTION_STRING=postgres://postgres:@localhost:5432/jamshot

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# --- R2 (API / audio / video use R2_BUCKET; plugin uploads use R2_BUCKET_NAME) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Set true only for the local Wrangler R2 emulator (see npm run ephemeral:setup)
# R2_FORCE_PATH_STYLE=

# --- Email ---
EMAIL=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
TEST_EMAIL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_TEAM_5_USERS_PRICE_ID=
STRIPE_TEAM_10_USERS_PRICE_ID=
STRIPE_TEAM_25_USERS_PRICE_ID=
STRIPE_TEAM_50_USERS_PRICE_ID=
STRIPE_TEAM_100_USERS_PRICE_ID=

# --- Auth / Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Misc API ---
IPGEO_API_KEY=
PLUGIN_META=

# --- UI (Next.js) ---
CMS_URL=http://localhost:3001
NEXT_PUBLIC_CMS_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:5002/api
NEXT_PUBLIC_PROJECT_WS_URL=ws://localhost:5003
NEXT_PUBLIC_R2_PUBLIC_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# --- CMS (Payload) ---
PAYLOAD_SECRET=
PREVIEW_SECRET=
CMS_DATABASE_URL=
