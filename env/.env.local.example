# Optional overlay. Copy to env/.env.local (or env/.env.ephemeral).
# Only list keys you want to change; everything else stays from env/.env.dev.
#
#   cp env/.env.local.example env/.env.local
#   # or: cp env/.env.local.example env/.env.ephemeral && JAMSHOT_ENV=ephemeral npm run dev:backend
#
# Delete the overlay file (or unset JAMSHOT_ENV) to point back at env/.env.dev.

# DB_HOST=
# DB_PORT=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_SSL=
# DB_CONNECTION_STRING=
# CMS_DATABASE_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
# NEXT_PUBLIC_R2_PUBLIC_URL=
# R2_FORCE_PATH_STYLE=
